{
  "framework": "vite",
  "buildCommand": "vite build",
  "installCommand": "npm install && npx prisma db push && npx prisma generate",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*": {
      "includeFiles": "prisma/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
