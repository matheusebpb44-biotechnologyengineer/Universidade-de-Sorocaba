generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Occurrence {
  id          Int       @id @default(autoincrement())
  titulo      String
  descricao   String
  categoria   String
  latitude    Float
  longitude   Float
  cpf         String    @default("")
  protocolo   String    @unique @default(cuid())
  status      String    @default("Em Análise")
  prioridade  String    @default("Normal")
  likes       Int       @default(0)
  resolvido   Boolean   @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  comments    Comment[]
}

model Comment {
  id           Int        @id @default(autoincrement())
  texto        String
  autorCpf     String     @default("")
  createdAt    DateTime   @default(now())
  occurrenceId Int
  occurrence   Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
}
